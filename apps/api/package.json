{
  "name": "@heat/api",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "tsx watch src/server.ts",
    "start": "node --import tsx src/server.ts",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "migrate": "tsx src/db/migrateCli.ts up",
    "migrate:down": "tsx src/db/migrateCli.ts down",
    "seed": "tsx seeds/las_vegas.ts"
  },
  "dependencies": {
    "@heat/api-contracts": "*",
    "@heat/config": "*",
    "@heat/domain": "*",
    "fastify": "^4.28.1",
    "@fastify/rate-limit": "^9.1.0",
    "pg": "^8.13.1",
    "zod": "^3.23.8"
  },
  "devDependencies": {
    "@types/node": "^22.10.2",
    "@types/pg": "^8.11.10",
    "tsx": "^4.19.2",
    "typescript": "^5.6.3",
    "vitest": "^2.1.8"
  }
}
