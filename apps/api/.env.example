# HEAT API environment (server-side only — never shipped to mobile)
NODE_ENV=development
PORT=8787
DATABASE_URL=postgres://heat:heat@localhost:5433/heat
LOG_LEVEL=info

# Provider keys are optional in V1 and must never be exposed to the client.
# TICKETMASTER_API_KEY=
# SEATGEEK_API_KEY=
# PREDICTHQ_API_KEY=
# ROUTING_PROVIDER_KEY=
