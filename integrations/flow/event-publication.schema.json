{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Flow event-publication contract v1 (DRAFT, NOT production authorized)",
  "description": "Additive versioned transport contract; server verification, authorization and data minimization required by integration adapters.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "event_id",
    "source_product",
    "revision",
    "status",
    "updated_at"
  ],
  "properties": {
    "event_id": {
      "type": "string",
      "format": "uuid"
    },
    "source_product": {
      "const": "tourify"
    },
    "revision": {
      "type": "integer",
      "minimum": 1
    },
    "status": {
      "enum": [
        "public",
        "unpublished",
        "canceled"
      ]
    },
    "updated_at": {
      "type": "string",
      "format": "date-time"
    },
    "title": {
      "type": "string",
      "minLength": 1,
      "maxLength": 220
    },
    "starts_at": {
      "type": "string",
      "format": "date-time"
    },
    "ends_at": {
      "type": "string",
      "format": "date-time"
    },
    "venue": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "venue_id",
        "name",
        "city",
        "country"
      ],
      "properties": {
        "venue_id": {
          "type": "string",
          "format": "uuid"
        },
        "name": {
          "type": "string",
          "minLength": 1
        },
        "city": {
          "type": "string",
          "minLength": 1
        },
        "region": {
          "type": "string",
          "minLength": 1
        },
        "country": {
          "type": "string",
          "minLength": 1
        }
      }
    },
    "public_url": {
      "type": "string",
      "format": "uri"
    },
    "description": {
      "type": "string",
      "maxLength": 2000
    }
  }
}

